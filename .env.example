# Copy to .env.local (git-ignored) and fill in from your Supabase project.
# Settings → API in the Supabase dashboard.
#
# When these are absent, the app runs on the in-memory prototype store — so it
# works with no configuration, and switches to Supabase automatically once set.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email notifications (optional). Get a key at resend.com (free tier). When set,
# owners get emailed on new applications, claims, and inquiries.
RESEND_API_KEY=
RESEND_FROM=Callsheet <alerts@yourdomain.com>
PLATFORM_INBOX=you@yourdomain.com

# Master account (optional overrides for the always-works owner login).
# MASTER_EMAIL=you@yourdomain.com
# MASTER_PASSWORD=change-me
# MASTER_TOKEN=some-long-random-string
